<Slide style={{ width: '1280px', height: '720px', background: '#0B1220', padding: '60px', flexDirection: 'column' }}>
  <Box style={{ flexDirection: 'column', gap: '16px' }}>
    <Text style={{ fontSize: '36px', color: '#E8ECF4', fontWeight: 'bold' }}>可复用的写作工具链</Text>
    <Box style={{ width: '100%', height: '1px', background: '#C8102E' }} />
  </Box>
  <Box style={{ marginTop: '44px', flexDirection: 'column', gap: '16px', flex: 1, justifyContent: 'center' }}>
    {[
      { n: '01', t: '扫榜分析脚本', d: 'scan_chart.py 零依赖运行：分类分布 / CR5 / HHI / 拥挤度评分，自动输出 Markdown 报告' },
      { n: '02', t: '四套创作模板', d: '选题立项书 / 世界观设定集 / 人物档案 / 大纲细纲——每套模板内嵌阶段纪律与自评表' },
      { n: '03', t: '闸门执法脚本', d: 'pipeline_check.py 三道闸：outline 大纲健康 / all 字数格式 / deai AI 味审计' },
      { n: '04', t: '一键打包交付', d: '工具链 zip（12.8KB）+ 全过程报告 + 提案，随项目一同交付' },
    ].map((item, i) => (
      <Box key={i} style={{ flexDirection: 'row', gap: '24px', alignItems: 'center', background: '#1E293B', padding: '20px 24px', borderRadius: '6px' }}>
        <Text style={{ width: '60px', fontSize: '32px', color: '#D4A24C', fontWeight: 'bold' }}>{item.n}</Text>
        <Box style={{ flexDirection: 'column', gap: '4px', flex: 1 }}>
          <Text style={{ fontSize: '22px', color: '#E8ECF4', fontWeight: 'bold' }}>{item.t}</Text>
          <Text style={{ fontSize: '17px', color: '#94A3B8', lineHeight: 1.5 }}>{item.d}</Text>
        </Box>
      </Box>
    ))}
  </Box>
</Slide>
