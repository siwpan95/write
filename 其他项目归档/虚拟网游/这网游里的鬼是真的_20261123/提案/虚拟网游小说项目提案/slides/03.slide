    <Box style={{ width: '100%', height: '1px', background: '#C8102E' }} />
  </Box>
  <Box style={{ marginTop: '48px', flexDirection: 'column', gap: '28px', flex: 1, justifyContent: 'center' }}>
    {[
      { n: '传统重生数值流', v: 72, c: '#C8102E', note: '红海 · 同配方跟作密集、头部固化' },
      { n: '游戏降临 / 卡BUG流', v: 55, c: '#D4A24C', note: '风口上升 · 供给增加中' },
