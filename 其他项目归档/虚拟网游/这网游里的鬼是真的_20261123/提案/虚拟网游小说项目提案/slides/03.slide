      { n: '网游 × 民俗怪谈', v: 38, c: '#4ADE80', note: '新蓝海 · 起点爆款验证 + 怪谈搜索暴涨 300%' },
    ].map((item, i) => (
      <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: '24px' }}>
        <Text style={{ width: '280px', fontSize: '20px', color: '#E8ECF4', fontWeight: i === 3 ? 'bold' : 'normal' }}>{item.n}</Text>
        <Box style={{ flex: 1, height: '28px', background: '#1E293B', borderRadius: '4px', flexDirection: 'row', justifyContent: 'flex-end' }}>
          <Box style={{ width: `${item.v}%`, height: '28px', background: item.c, borderRadius: '4px' }} />
        </Box>
        <Text style={{ width: '80px', fontSize: '28px', color: item.c, fontWeight: 'bold', textAlign: 'right' }}>{item.v}</Text>
        <Text style={{ width: '340px', fontSize: '16px', color: '#94A3B8' }}>{item.note}</Text>
      </Box>
    ))}
  </Box>
  <Box style={{ background: '#C8102E', padding: '16px 24px', borderRadius: '6px' }}>
    <Text style={{ fontSize: '22px', color: '#FFFFFF', fontWeight: 'bold' }}>结论：正面跟作无胜算，融合细分才有窗口——网游×民俗怪谈是六方向中拥挤度最低的切入点</Text>
