<Slide style={{ width: '1280px', height: '720px', background: '#0B1220', padding: '60px', flexDirection: 'column' }}>
  <Box style={{ flexDirection: 'column', gap: '16px' }}>
    <Text style={{ fontSize: '36px', color: '#E8ECF4', fontWeight: 'bold' }}>九阶段生产链：从扫榜到成稿</Text>
    <Box style={{ width: '100%', height: '1px', background: '#C8102E' }} />
  </Box>
  <Box style={{ marginTop: '48px', flexDirection: 'column', gap: '18px', flex: 1, justifyContent: 'center' }}>
    <Box style={{ flexDirection: 'row', gap: '8px', flexWrap: 'wrap', justifyContent: 'center' }}>
      {['① 扫榜分析', '② 选题立意', '③ 世界观', '④ 人物塑造', '⑤ 大纲细纲', '⑥ 章节写作', '⑦ 节奏把控', '⑧ 润色改稿', '⑨ 审查修改'].map((s, i) => (
        <Box key={i} style={{ background: i === 5 ? '#C8102E' : '#1E293B', padding: '14px 16px', borderRadius: '6px', border: i === 5 ? 'none' : '1px solid #334155' }}>
          <Text style={{ fontSize: '17px', color: i === 5 ? '#FFFFFF' : '#E8ECF4', fontWeight: i === 5 ? 'bold' : 'normal' }}>{s}</Text>
        </Box>
      ))}
    </Box>
    <Box style={{ flexDirection: 'row', gap: '24px', marginTop: '24px' }}>
      <Box style={{ flex: 1, background: '#1E293B', borderRadius: '8px', padding: '24px', borderTop: '3px solid #D4A24C' }}>
        <Text style={{ fontSize: '22px', color: '#D4A24C', fontWeight: 'bold' }}>串行 + 并行编排</Text>
        <Text style={{ fontSize: '18px', color: '#E8ECF4', lineHeight: 1.6, marginTop: '8px' }}>扫榜→选题串行；世界观与人物并行；大纲依赖两者；正文逐批循环。每阶段产出原文完整传递，不摘要化。</Text>
      </Box>
      <Box style={{ flex: 1, background: '#1E293B', borderRadius: '8px', padding: '24px', borderTop: '3px solid #C8102E' }}>
        <Text style={{ fontSize: '22px', color: '#C8102E', fontWeight: 'bold' }}>出口设闸门</Text>
        <Text style={{ fontSize: '18px', color: '#E8ECF4', lineHeight: 1.6, marginTop: '8px' }}>大纲、正文、AI 味三道脚本闸门；退出码 0 才算过闸。无脚本输出的口头「已完成」一律不采信。</Text>
      </Box>
    </Box>
  </Box>
</Slide>
