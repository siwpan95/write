{
  "_说明": "《无敌不是他人路》审校配置。metrics 声明指标口径，terms 登记专名合法变体。",
  "_口径裁定_20261113": "「真气」条目是**防回归闸**，不是现行记账口径：2026-11-13 依 03 §9.2「无面板数值、按症状可观测」裁定，台账已改用 R2 症状三联（肋下旧伤抽痛／额角细汗／指尖微颤），正文与台账不再出现百分比。若有人把真气重新写成 70%→68% 这类数值账，本规则会立即报 NUM-METRIC 冲突（声明处＋记账处同时命中才报）。",
  "metrics": {
    "真气": {
      "scope": ["无敌不是他人路"],
      "pattern": "真气[^。；\\n]{0,10}?(\\d+(?:\\.\\d+)?)%",
      "mode": "state",
      "forbid_if": "无面板数值"
    },
    "暴露层级": {
      "scope": ["无敌不是他人路"],
      "pattern": "暴露层级\\s*(\\d+(?:\\.\\d+)?)",
      "mode": "state"
    },
    "龙鳞在册人数": {
      "scope": ["无敌不是他人路"],
      "pattern": "在册\\s*(\\d+)\\s*人",
      "mode": "constant"
    },
    "结算间隔": {
      "scope": ["提交确实未创建"],
      "pattern": "结算间隔[^\\n]{0,20}?≥\\s*(\\d+)\\s*日",
      "mode": "constant"
    }
  },
  "terms": {
    "楚嫣然": ["楚嫣然", "嫣然"],
    "林枫": ["林枫"],
    "楚家": ["楚家", "楚氏"],
    "龙鳞": ["龙鳞"],
    "冥殿": ["冥殿"]
  },
  "ignore": [
    "^#{1,6}\\s",
    "^\\s*>",
    "^\\|\\s*[-: ]+\\|"
  ],
  "chapter_pattern": "第(\\d+)章"
}
