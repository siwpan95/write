{
  "_说明": "《无敌不是他人路》审校配置。metrics 声明指标口径，terms 登记专名合法变体。",
  "metrics": {
    "真气": {
      "scope": ["无敌不是他人路"],
      "pattern": "真气[^。；\\n]{0,10}?(\\d+(?:\\.\\d+)?)%",
      "mode": "state",
      "forbid_if": "无面板数值"
    },
    "暴露层级": {
      "scope": ["无敌不是他人路"],
      "pattern": "暴露层级\\s*(\\d+(?:\\.\\d+)?)",
      "mode": "state"
    },
    "龙鳞在册人数": {
      "scope": ["无敌不是他人路"],
      "pattern": "在册\\s*(\\d+)\\s*人",
      "mode": "constant"
    },
    "结算间隔": {
      "scope": ["提交确实未创建"],
      "pattern": "结算间隔[^\\n]{0,20}?≥\\s*(\\d+)\\s*日",
      "mode": "constant"
    }
  },
  "terms": {
    "楚嫣然": ["楚嫣然", "嫣然"],
    "林枫": ["林枫"],
    "楚家": ["楚家", "楚氏"],
    "龙鳞": ["龙鳞"],
    "冥殿": ["冥殿"]
  },
  "ignore": [
    "^#{1,6}\\s",
    "^\\s*>",
    "^\\|\\s*[-: ]+\\|"
  ],
  "chapter_pattern": "第(\\d+)章"
}
